# TEMPLATE ONLY — Vite does NOT read this file.
# Copy it, don't rename it:   cp .env.example .env
# Renaming destroys your real .env.
#
# WARNING: every VITE_* value ships inside the browser bundle and is public.
# Never put a service_role key or any secret here.

VITE_SUPABASE_URL=

# The ANON / PUBLIC key — Dashboard > Settings > API Keys.
# Legacy format is a JWT whose payload reads "role":"anon".
# New format looks like sb_publishable_xxxx (NOT a JWT).
VITE_SUPABASE_ANON_KEY=

VITE_GOOGLE_MAPS_API_KEY=

# Optional — falls back to a localhost default when unset.
# VITE_API_URL=http://localhost:8000
