# Backend env (Python). Copy to `.env` and fill in real values.
# The VITE_* entries below are NOT read by Vite from this file —
# the frontend reads the project-root .env. They are duplicated here
# only if the backend itself needs them.

# --- Local AI chat (Ollama) — powers /controller/chat ---
# Both optional; these are the defaults.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Direct Postgres connection (Supabase > Project Settings > Database > Connection
# string). Powers the ATS tools (search_candidates, get_candidate, etc.) that the
# Ollama chat calls. Without this, those tools return a clear config error instead
# of failing the whole chat.
# Consider a read-only DB role: /controller/chat has no auth in front of it, and
# these tools can return full candidate PII (NIK, salary, family data).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ulciiqwhfviilhgwbbmc.supabase.co:5432/postgres

GEMINI_API_KEY=
# Primary Agent (chat + tools + retrieval)
GEMINI_PRIMARY_MODEL=
GEMINI_PRIMARY_FALLBACK_MODELS=


# Reasoning (complex analysis / decision making)
GEMINI_REASONING_MODEL=
GEMINI_REASONING_FALLBACK_MODELS=


# Summary (CV summary / extraction)
GEMINI_SUMMARY_MODEL=
GEMINI_SUMMARY_FALLBACK_MODELS=

POCKETBASE_URL=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

PB_COLLECTION_CANDIDATES=
PB_COLLECTION_JOBS=
PB_COLLECTION_TRACKING=
RESEND_API_KEY=
ALLOWED_ORIGINS=
MAX_AGENT_TOOL_HOPS=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_GOOGLE_MAPS_API_KEY=