"""
seed_candidates.py

One file that does everything:
  - Supabase client (hardcode your URL/key below)
  - insert_* helpers for every table in schema.sql
  - a randomized Indonesian candidate generator (names, addresses, education,
    employment history, family, etc.)
  - a runner that generates N candidates with applied_at spread realistically
    over the past X days and inserts them

Install:
  pip install supabase faker --break-system-packages

Usage:
  python seed_candidates.py --count 350 --days-back 60
  python seed_candidates.py --count 20 --seed 42       # reproducible batch
  python seed_candidates.py --count 1 --days-back 0    # quick single test
"""

from __future__ import annotations

import argparse
import random
import time
from datetime import datetime, timedelta, timezone
from typing import Any

from faker import Faker
from supabase import create_client, Client

